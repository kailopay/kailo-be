    },
    {
      "name": "Developer Webhooks",
      "description": "Session-authenticated developer webhook endpoint registration. Delivery worker and retry behavior are separate release work.",
      "item": [
        {
          "name": "Register webhook endpoint",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.endpoint && body.endpoint.id) pm.environment.set('webhook_endpoint_id', body.endpoint.id);",
                  "  if (body.secret) pm.environment.set('webhook_signing_secret', body.secret);",
                  "  pm.test('endpoint and one-time secret are returned', function () { pm.expect(body.endpoint.id).to.be.a('string'); pm.expect(body.secret).to.be.a('string'); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "kailopay_session={{session_cookie}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"url\": \"{{webhook_url}}\",\n  \"event_types\": [\n    \"order.created\",\n    \"order.payment_confirmed\",\n    \"order.completed\",\n    \"order.failed\"\n  ]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/v1/webhook-endpoints"
          }
        },
        {
          "name": "List webhook endpoints",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Cookie", "value": "kailopay_session={{session_cookie}}" }
            ],
            "url": "{{base_url}}/v1/webhook-endpoints"
          }
        },
        {
          "name": "Disable webhook endpoint",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Cookie", "value": "kailopay_session={{session_cookie}}" }
            ],
            "url": "{{base_url}}/v1/webhook-endpoints/{{webhook_endpoint_id}}"
          }
        }
      ]
    },
    {
      "name": "Provider Callbacks",
      "description": "Callback request fixtures. Persona uses a Postman pre-request script to sign the exact raw body with persona_webhook_secret. Xendit requires the configured callback token and an existing checkout identifier.",
      "item": [
        {
          "name": "Xendit payment session completed",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-callback-token", "value": "{{xendit_callback_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment_session.completed\",\n  \"data\": {\n    \"payment_session_id\": \"{{payment_session_id}}\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/callbacks/payments/xendit"
          }
        },
        {
          "name": "Xendit payment capture",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-callback-token", "value": "{{xendit_callback_token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event\": \"payment.capture\",\n  \"data\": {\n    \"payment_id\": \"{{payment_id}}\",\n    \"payment_session_id\": \"{{payment_session_id}}\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/callbacks/payments/xendit"
          }
        }
      ]
    }
  ]
