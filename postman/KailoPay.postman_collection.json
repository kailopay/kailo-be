              "type": "bearer",
              "bearer": [ { "key": "token", "value": "{{api_key}}", "type": "string" } ]
            },
            "url": "{{base_url}}/sep24/interactive/{{transaction_id}}"
          }
        },
        {
          "name": "Legacy SEP-24 deposit path",
          "request": {
