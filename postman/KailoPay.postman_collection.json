    {
      "name": "Auth and Profile",
      "description": "Public account endpoints and session-authenticated profile operations. Login stores the kailopay_session cookie in the selected Postman environment.",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\",\n  \"display_name\": \"{{display_name}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/register"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login succeeded', function () { pm.response.to.have.status(200); });",
                  "const setCookie = pm.response.headers.get('Set-Cookie') || '';",
                  "const match = setCookie.match(/(?:^|,\\s*)kailopay_session=([^;]+)/);",
                  "if (match) pm.environment.set('session_cookie', match[1]);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/auth/login"
          }
        },
        {
          "name": "Start Google login",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/google/login",
            "description": "Redirects to Google when Google OAuth is configured. Disable follow redirects to inspect the Location header."
          },
          "protocolProfileBehavior": { "followRedirects": false }
        },
        {
          "name": "Complete Google login",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/auth/google/callback?code={{google_code}}&state={{google_state}}",
            "description": "Use only with a real one-time Google OAuth code and state."
          },
          "protocolProfileBehavior": { "followRedirects": false }
        },
