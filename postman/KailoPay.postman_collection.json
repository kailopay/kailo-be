    {
      "name": "Orders",
      "description": "API-key-authenticated on-ramp, off-ramp, and owner-scoped order requests. Use the API key captured by Create sandbox API key.",
      "item": [
        {
          "name": "Create on-ramp order - QRIS",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([200, 201].includes(pm.response.code)) {",
                  "  const body = pm.response.json();",
                  "  if (body.order && body.order.id) pm.environment.set('order_id', body.order.id);",
                  "  if (body.order && body.order.checkout) {",
                  "    pm.environment.set('checkout_id', body.order.checkout.id || '');",
                  "    pm.environment.set('payment_session_id', body.order.checkout.id || '');",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [ { "key": "token", "value": "{{api_key}}", "type": "string" } ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fiat\": {\n    \"currency\": \"IDR\",\n    \"amount_minor\": \"100000\"\n  },\n  \"payment_method\": \"qris\",\n  \"stellar_destination\": {\n    \"account\": \"{{stellar_account}}\",\n    \"memo\": \"postman\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/v1/onramps"
          }
        },
        {
          "name": "Create off-ramp order - simulated bank transfer",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([200, 201].includes(pm.response.code)) {",
                  "  const body = pm.response.json();",
                  "  if (body.order && body.order.id) pm.environment.set('order_id', body.order.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "auth": {
              "type": "bearer",
              "bearer": [ { "key": "token", "value": "{{api_key}}", "type": "string" } ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"asset\": {\n    \"network\": \"stellar_testnet\",\n    \"code\": \"XLM\",\n    \"amount\": \"1.0000000\"\n  },\n  \"withdrawal\": {\n    \"currency\": \"IDR\",\n    \"method\": \"sandbox_bank_transfer\",\n    \"destination_token\": \"postman-bank-destination\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/v1/offramps"
          }
