    {
      "name": "Persona KYC",
      "description": "Session-authenticated KYC status and inquiry requests plus a signed synthetic callback helper. Complete the real Persona sandbox flow for provider evidence.",
      "item": [
        {
          "name": "Get KYC status",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Cookie", "value": "kailopay_session={{session_cookie}}" },
              { "key": "Cache-Control", "value": "no-store" }
            ],
            "url": "{{base_url}}/v1/kyc"
          }
        },
        {
          "name": "Start or resume Persona inquiry",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.inquiry && body.inquiry.inquiry_id) pm.environment.set('persona_inquiry_id', body.inquiry.inquiry_id);",
                  "  pm.test('inquiry response contains an inquiry', function () { pm.expect(body.inquiry.inquiry_id).to.be.a('string'); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Cookie", "value": "kailopay_session={{session_cookie}}" },
              { "key": "Cache-Control", "value": "no-store" }
            ],
            "url": "{{base_url}}/v1/kyc/inquiry"
          }
        },
        {
          "name": "Persona callback - synthetic approved event",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const secret = pm.environment.get('persona_webhook_secret') || '';",
                  "const timestamp = String(Math.floor(Date.now() / 1000));",
                  "const rawBody = pm.variables.replaceIn(pm.request.body.raw || '');",
                  "const digest = CryptoJS.HmacSHA256(timestamp + '.' + rawBody, secret).toString(CryptoJS.enc.Hex);",
                  "pm.request.headers.upsert({ key: 'Persona-Signature', value: 't=' + timestamp + ',v1=' + digest });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('callback was accepted or safely replayed', function () { pm.expect(pm.response.code).to.be.oneOf([200]); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Persona-Signature", "value": "{{persona_signature}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"data\": {\n    \"id\": \"{{persona_event_id}}\",\n    \"type\": \"event\",\n    \"attributes\": {\n      \"name\": \"inquiry.approved\",\n      \"created-at\": \"{{persona_event_created_at}}\",\n      \"payload\": {\n        \"data\": {\n          \"id\": \"{{persona_inquiry_id}}\",\n          \"type\": \"inquiry\",\n          \"attributes\": {\n            \"status\": \"approved\"\n          }\n        }\n      }\n    }\n  }\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/callbacks/kyc/persona"
          }
        }
      ]
    },
    {
      "name": "API Keys",
      "description": "Developer API-key management. KYC approval is required before Create API key succeeds.",
      "item": [
        {
          "name": "Create sandbox API key",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const body = pm.response.json();",
                  "  if (body.api_key && body.api_key.key) pm.environment.set('api_key', body.api_key.key);",
                  "  if (body.api_key && body.api_key.id) pm.environment.set('api_key_id', body.api_key.id);",
                  "  pm.test('one-time API key is returned', function () { pm.expect(body.api_key.key).to.match(/^pk_test_/); });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Cookie", "value": "kailopay_session={{session_cookie}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman sandbox key\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": "{{base_url}}/v1/api-keys"
