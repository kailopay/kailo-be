              "bearer": [ { "key": "token", "value": "{{api_key}}", "type": "string" } ]
            },
            "url": "{{base_url}}/sep24/transaction?id={{transaction_id}}"
          }
        },
        {
          "name": "SEP-24 interactive projection",
          "request": {
