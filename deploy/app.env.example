# Copy this file to deploy/app.env and replace every placeholder.
# PostgreSQL and MinIO connection values are injected by compose.deploy.yaml.
APP_ENV=production
APP_VERSION=0.1.0

HTTP_ADDRESS=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_ALLOWED_ORIGINS=https://app.example.com
HEALTH_CHECK_TIMEOUT=2s

DATABASE_MAX_OPEN_CONNS=20
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_PING_TIMEOUT=3s

MINIO_BUCKET=kailopay-profile
MINIO_REGION=us-east-1

PROFILE_AVATAR_MAX_BYTES=5242880
LOG_LEVEL=info
LOG_FORMAT=json

AUTH_SUCCESS_REDIRECT_URL=https://app.example.com/
AUTH_EMAIL_LINK_BASE_URL=https://app.example.com/
AUTH_TRANSACTION_ENCRYPTION_KEY=replace-with-32-byte-base64-key
AUTH_SESSION_HMAC_KEY=replace-with-another-32-byte-base64-key
AUTH_SESSION_ABSOLUTE_LIFETIME=8h
AUTH_SESSION_IDLE_LIFETIME=30m
AUTH_TRANSACTION_LIFETIME=10m
AUTH_COOKIE_NAME=kailopay_session
AUTH_COOKIE_SECURE=true

# Use gmail for real verification and reset delivery. Console is acceptable
# for a sandbox deployment when links are intentionally read from logs.
EMAIL_PROVIDER=console
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
GMAIL_FROM_NAME=KailoPay
GMAIL_SMTP_TIMEOUT=10s

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://api.example.com/auth/google/callback

API_KEY_PEPPER=replace-with-at-least-32-random-bytes
COINMARKETCAP_BASE_URL=https://pro-api.coinmarketcap.com
COINMARKETCAP_API_KEY=replace-with-coinmarketcap-key
COINMARKETCAP_TIMEOUT=5s
QUOTE_TTL=5m
QUOTE_MAX_AGE=2m
QUOTE_SPREAD_BPS=0
ORDER_MIN_IDR=10000
ORDER_MAX_IDR=10000000

XENDIT_BASE_URL=https://api.xendit.co
XENDIT_SECRET_KEY=xnd_development_replace-with-test-key
XENDIT_CALLBACK_TOKEN=replace-with-xendit-webhook-token
XENDIT_API_VERSION=2024-11-11
XENDIT_QRIS_CHANNEL=QRIS
XENDIT_VA_CHANNEL=BRI_VIRTUAL_ACCOUNT
XENDIT_TIMEOUT=10s

STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_TREASURY_ACCOUNT=G_REPLACE_WITH_TESTNET_PUBLIC_KEY
OFFRAMP_DEPOSIT_ACCOUNT=G_REPLACE_WITH_TESTNET_DEPOSIT_PUBLIC_KEY
OFFRAMP_DEPOSIT_EXPIRY=24h
STELLAR_OPERATING_BUFFER_STROOPS=10000000
STELLAR_TIMEOUT=10s
WORKER_POLL_INTERVAL=1s
WORKER_LEASE_DURATION=30s
WORKER_RETRY_DELAY=5s
WORKER_SUBMISSION_TIMEOUT=1m
WORKER_MAX_ATTEMPTS=5
