# Compose interpolation and infrastructure credentials.
# Copy this file to deploy/production.env and replace every placeholder.
POSTGRES_DB=kailopay
POSTGRES_USER=kailopay
POSTGRES_PASSWORD=replace-with-a-long-random-password

# The API binds to loopback by default. Put a reverse proxy in front of it.
API_PORT=8080

MINIO_ROOT_USER=kailopay-minio
MINIO_ROOT_PASSWORD=replace-with-another-long-random-password
MINIO_CERTS_DIR=./deploy/minio/certs
