APP_ENV=local
APP_VERSION=dev

HTTP_ADDRESS=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

HEALTH_CHECK_TIMEOUT=2s

DATABASE_DSN=host=localhost user=postgres password=postgres dbname=kailopay port=5432 sslmode=disable TimeZone=UTC
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_PING_TIMEOUT=3s

# Docker Compose local infrastructure defaults.
POSTGRES_DB=kailopay
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Backend connection to the private MinIO profile bucket.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=kailopay-profile
MINIO_REGION=us-east-1
MINIO_USE_SSL=false
PROFILE_AVATAR_MAX_BYTES=5242880

# Local development defaults. Use info/json in production.
LOG_LEVEL=info
LOG_FORMAT=text

# Self-hosted authentication. Generate each key with:
#   openssl rand -base64 32
AUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/
# Frontend base URL used to build verification and password-reset links.
AUTH_EMAIL_LINK_BASE_URL=http://localhost:3000/
AUTH_TRANSACTION_ENCRYPTION_KEY=replace-with-32-byte-base64-key
AUTH_SESSION_HMAC_KEY=replace-with-another-32-byte-base64-key
AUTH_SESSION_ABSOLUTE_LIFETIME=8h
AUTH_SESSION_IDLE_LIFETIME=30m
AUTH_TRANSACTION_LIFETIME=10m
AUTH_COOKIE_NAME=kailopay_session
AUTH_COOKIE_SECURE=false

# Optional Google sign-in. Leave both credentials empty to disable the
# Google endpoints. Create an OAuth client at console.cloud.google.com with
# redirect URI http://localhost:8080/auth/google/callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/auth/google/callback

# Week 1 sandbox on-ramp. Never commit real values.
API_KEY_PEPPER=replace-with-at-least-32-random-bytes
COINMARKETCAP_BASE_URL=https://pro-api.coinmarketcap.com
COINMARKETCAP_API_KEY=replace-with-coinmarketcap-key
COINMARKETCAP_TIMEOUT=5s
QUOTE_TTL=5m
QUOTE_MAX_AGE=2m
QUOTE_SPREAD_BPS=0
ORDER_MIN_IDR=10000
ORDER_MAX_IDR=10000000

XENDIT_BASE_URL=https://api.xendit.co
XENDIT_SECRET_KEY=xnd_development_replace-with-test-key
XENDIT_CALLBACK_TOKEN=replace-with-xendit-webhook-token
XENDIT_API_VERSION=2024-11-11
XENDIT_QRIS_CHANNEL=QRIS
XENDIT_VA_CHANNEL=BRI_VIRTUAL_ACCOUNT
XENDIT_TIMEOUT=10s

STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_TREASURY_ACCOUNT=G_REPLACE_WITH_TESTNET_PUBLIC_KEY
# Off-ramp deposit processing account (receives user deposits; worker-only secret).
OFFRAMP_DEPOSIT_ACCOUNT=G_REPLACE_WITH_TESTNET_DEPOSIT_PUBLIC_KEY
OFFRAMP_DEPOSIT_EXPIRY=24h
# Worker-only secret; the API process configuration never reads this value.
# Deployed API environments must not set it.
STELLAR_TREASURY_SECRET=S_REPLACE_WITH_TESTNET_SECRET
# Worker-only off-ramp deposit account secret (burn-address retirement).
OFFRAMP_DEPOSIT_SECRET=S_REPLACE_WITH_DEPOSIT_SECRET
STELLAR_OPERATING_BUFFER_STROOPS=10000000
STELLAR_TIMEOUT=10s
WORKER_POLL_INTERVAL=1s
WORKER_LEASE_DURATION=30s
WORKER_RETRY_DELAY=5s
WORKER_SUBMISSION_TIMEOUT=1m
WORKER_MAX_ATTEMPTS=5
