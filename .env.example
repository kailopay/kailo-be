APP_ENV=local
APP_VERSION=dev

HTTP_ADDRESS=:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

HEALTH_CHECK_TIMEOUT=2s

DATABASE_DSN=host=localhost user=postgres password=postgres dbname=kailopay port=5432 sslmode=disable TimeZone=UTC
DATABASE_MAX_OPEN_CONNS=10
DATABASE_MAX_IDLE_CONNS=5
DATABASE_CONN_MAX_LIFETIME=30m
DATABASE_CONN_MAX_IDLE_TIME=5m
DATABASE_PING_TIMEOUT=3s

# Local development defaults. Use info/json in production.
LOG_LEVEL=info
LOG_FORMAT=text

# Auth0 Regular Web Application. Replace placeholders with tenant values.
AUTH0_ISSUER_URL=https://your-tenant.us.auth0.com/
AUTH0_CLIENT_ID=replace-with-auth0-client-id
AUTH0_CLIENT_SECRET=replace-with-auth0-client-secret
AUTH0_REDIRECT_URL=http://localhost:8080/auth/callback
AUTH0_EMAIL_CONNECTION=email
AUTH_SUCCESS_REDIRECT_URL=http://localhost:3000/

# Generate each value with: openssl rand -base64 32
AUTH_TRANSACTION_ENCRYPTION_KEY=replace-with-32-byte-base64-key
AUTH_SESSION_HMAC_KEY=replace-with-another-32-byte-base64-key
AUTH_SESSION_ABSOLUTE_LIFETIME=8h
AUTH_SESSION_IDLE_LIFETIME=30m
AUTH_TRANSACTION_LIFETIME=10m
AUTH_COOKIE_NAME=kailopay_session
AUTH_COOKIE_SECURE=false
